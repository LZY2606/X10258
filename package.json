{
  "name": "spice-pairwise-equivalence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "网表双影室：SPICE 子电路展开、参数作用域与连接等价（离线可追溯复核）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "replay": "node --experimental-sqlite --import tsx scripts/replay.ts",
    "build:casepack": "node --experimental-sqlite --import tsx src/casepack/build.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
